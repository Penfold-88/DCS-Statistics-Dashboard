# DCS Statistics Dashboard - Docker Environment Example
# Copy this file to .env in the repository root before starting Docker.

# ------------------------------------------------------------------------------
# Basic container settings
# ------------------------------------------------------------------------------

CONTAINER_NAME=dcs-statistics
HOSTNAME=dcs-stats
IMAGE_TAG=latest
PHP_VERSION=8.2
RESTART_POLICY=unless-stopped

# Public web port.
# Change WEB_PORT if port 8080 is already used on your machine/server.
WEB_PORT=8080
INTERNAL_PORT=80

# Run as the non-root www user by default.
# Only set this to true if you understand the security tradeoff.
RUN_AS_ROOT=false

# ------------------------------------------------------------------------------
# PHP runtime settings
# ------------------------------------------------------------------------------

PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_TIME=300
PHP_MAX_INPUT_VARS=1000
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_POST_MAX_SIZE=64M
PHP_SESSION_TIMEOUT=1440
PHP_DISPLAY_ERRORS=Off
PHP_ERROR_REPORTING=E_ALL & ~E_DEPRECATED & ~E_STRICT

# Production defaults.
# After using the dashboard updater, restart the container so PHP loads new files.
OPCACHE_VALIDATE_TIMESTAMPS=0
OPCACHE_REVALIDATE_FREQ=0

# For local Docker development only, you may use:
# OPCACHE_VALIDATE_TIMESTAMPS=1
# OPCACHE_REVALIDATE_FREQ=2

# Container timezone.
TIMEZONE=UTC

# Optional secure DCSServerBot API key override.
# If set, this is used instead of the saved key in site-config/data/api_config.json.
DCSBOT_API_KEY=

# Optional stable master secret for encrypting a saved API key.
# Keep this value unchanged after first use or the saved key cannot be decrypted.
DCS_CONFIG_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Health checks and logs
# ------------------------------------------------------------------------------

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START=30s

LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ------------------------------------------------------------------------------
# Optional resource and network limits
# ------------------------------------------------------------------------------

CPU_LIMIT=2
CPU_RESERVATION=0.5
MEMORY_LIMIT=512M
MEMORY_RESERVATION=256M
NETWORK_SUBNET=172.20.0.0/16

# ------------------------------------------------------------------------------
# Container labels
# ------------------------------------------------------------------------------

VERSION=1.2
MAINTAINER=admin@example.com
